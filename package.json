{
    "name": "libass-webos-legacy",
    "version": "1.0.0",
    "description": "A lightweight ASS subtitle rendering pipeline for legacy LG webOS browsers, built around libass with event-driven caching and performance-focused scheduling.",
    "scripts": {
        "lint": "npx eslint --ext .js ./src",
        "types": "rm -rf dist/types && npx tsc",
        "webpack": "npm run webpack-modern && npm run webpack-legacy",
        "webpack-modern": "JAS_TARGER=modern webpack --config webpack/modern/webpack.modern.prod.cjs",
        "webpack-legacy": "JAS_TARGER=legacy webpack --config webpack/legacy/webpack.legacy.prod.cjs",
        "clean": "./build.sh all clean",
        "clean-libs": "./build.sh all clean-libs",
        "clean-js": "./build.sh all clean-js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ediaz23/libass-webos-legacy.git"
    },
    "types": "./dist/types/libass.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/libass.d.ts",
            "default": "./dist/modern/libass.min.js"
        },
        "./debug": {
            "types": "./dist/types/libass.d.ts",
            "default": "./dist/modern/libass.debug.js"
        },
        "./legacy": {
            "types": "./dist/types/libass.d.ts",
            "default": "./dist/legacy/libass.min.js"
        },
        "./legacy/debug": {
            "types": "./dist/types/libass.d.ts",
            "default": "./dist/legacy/libass.debug.js"
        },
        "./legacy/*": "./dist/legacy/*",
        "./modern/*": "./dist/modern/*",
        "./default-font": "./default.woff2"
    },
    "files": [
        "dist",
        "LICENSE",
        "THIRD_PARTY_LICENSES",
        "README.md",
        "default.woff2"
    ],
    "keywords": [
        "libass",
        "subtitle",
        "ass",
        "wasm",
        "emscripten",
        "webos",
        "chromium68",
        "legacy"
    ],
    "author": "Esteban Díaz <esteban.diazt23@gmail.com>",
    "license": "LGPL-2.1-or-later AND (FTL OR GPL-2.0-or-later) AND MIT AND ISC AND Apache-2.0",
    "type": "module",
    "bugs": {
        "url": "https://github.com/ediaz23/libass-webos-legacy/issues"
    },
    "homepage": "https://github.com/ediaz23/libass-webos-legacy#readme",
    "dependencies": {
        "@babel/runtime": "^7.27.6",
        "rvfc-legacy-polyfill": "^0.1.0"
    },
    "devDependencies": {
        "@babel/core": "^7.26.0",
        "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
        "@babel/plugin-proposal-optional-chaining": "^7.21.0",
        "@babel/plugin-transform-parameters": "^7.25.9",
        "@babel/plugin-transform-runtime": "^7.25.9",
        "@babel/preset-env": "^7.24.4",
        "@eslint/js": "^9.30.1",
        "@types/node": "^18.19.115",
        "babel-loader": "^9.1.3",
        "copy-webpack-plugin": "^13.0.0",
        "core-js": "^3.39.0",
        "eslint": "^9.39.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^17.21.0",
        "globals": "^16.3.0",
        "string-replace-loader": "^3.1.0",
        "terser-webpack-plugin": "^5.3.14",
        "typescript": "^5.6.0",
        "webpack": "^5.94.0",
        "webpack-cli": "^5.1.4",
        "webpack-conditional-loader": "^1.0.12",
        "webpack-merge": "^5.10.0"
    },
    "allowScripts": {
        "core-js@3.49.0": true
    }
}
